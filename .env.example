# Copy to .env and adjust. All variables are optional; defaults live in src/hrt/config.py.

# --- LLM ---------------------------------------------------------------------
HRT_LLM_PROVIDER=ollama            # ollama | fake
HRT_OLLAMA_MODEL=llama3.2:3b
HRT_OLLAMA_URL=http://127.0.0.1:11434
# Portable Ollama install kept on D: so it can be deleted cleanly after the project.
HRT_OLLAMA_EXE=D:/Ollama/app/ollama.exe
HRT_OLLAMA_MODELS_DIR=D:/Ollama/models

# --- Tier 1 ------------------------------------------------------------------
HRT_WINDOW_SECONDS=10
HRT_BENIGN_SCORE_QUANTILE=0.995

# --- Tier 3 ------------------------------------------------------------------
# Networks the agent must never block (comma-separated JSON handled by pydantic).
# HRT_PROTECTED_SUBNETS=["10.10.0.0/24","203.0.113.10/32","127.0.0.0/8","0.0.0.0/32"]
HRT_AUTO_DEPLOY=false              # true = deploy verified rules without analyst approval

# --- orchestrator ------------------------------------------------------------
HRT_HOST=127.0.0.1
HRT_PORT=8000
